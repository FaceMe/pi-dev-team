{
  "name": "pi-model-picker",
  "version": "2.0.0",
  "description": "Two-panel model picker, role manager (daily/small/frontier), reasoning-effort controller, and a hybrid main/sidekick model harness for the pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "rsudharshan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaceMe/pi-dev-team.git"
  },
  "keywords": [
    "fusion",
    "model-picker",
    "model-roles",
    "model-routing",
    "pi",
    "pi-package",
    "reasoning-effort",
    "sidekick"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.20.4",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  }
}
